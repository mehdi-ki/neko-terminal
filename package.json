{
  "name": "neko-terminal",
  "version": "1.2.0",
  "description": "A kitty-style terminal for Windows, macOS and Linux, built to work well with Claude Code",
  "main": "bootstrap.js",
  "scripts": {
    "start": "electron .",
    "predist": "node scripts/write-build-info.js",
    "dist": "electron-builder --win portable",
    "dist:release": "node scripts/write-build-info.js && electron-builder --publish never"
  },
  "keywords": [
    "terminal",
    "terminal-emulator",
    "electron",
    "xterm",
    "claude-code",
    "claude",
    "ai",
    "kitty",
    "windows-terminal",
    "conpty",
    "tiling",
    "split-panes"
  ],
  "author": {
    "name": "mehdi-ki",
    "email": "335664473+mehdi-ki@users.noreply.github.com",
    "url": "https://github.com/mehdi-ki"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "0.10.0-beta.1",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.mehdi-ki.neko-terminal",
    "productName": "Neko Terminal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "bootstrap.js",
      "main.js",
      "preload.js",
      "build-info.json",
      "cli/**",
      "renderer/**",
      "assets/**",
      "node_modules/**",
      "!node_modules/@fontsource/jetbrains-mono/files/!(jetbrains-mono-latin-*-normal.woff2)"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.png",
      "artifactName": "NekoTerminal-${version}-windows-portable.exe"
    },
    "portable": {
      "artifactName": "NekoTerminal-${version}-windows-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-1024.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "NekoTerminal-${version}-mac-${arch}.${ext}",
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-1024.png",
      "category": "System;TerminalEmulator",
      "artifactName": "NekoTerminal-${version}-linux-${arch}.${ext}",
      "maintainer": "mehdi-ki <335664473+mehdi-ki@users.noreply.github.com>",
      "synopsis": "Kitty-style terminal built to work well with Claude Code"
    }
  },
  "homepage": "https://github.com/mehdi-ki/neko-terminal",
  "repository": {
    "type": "git",
    "url": "https://github.com/mehdi-ki/neko-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/mehdi-ki/neko-terminal/issues"
  }
}
